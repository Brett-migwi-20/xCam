<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer lens barrel (r=32, stays inside the 66dp adaptive-icon safe zone) -->
    <path android:pathData="M22,54a32,32 0 1,0 64,0a32,32 0 1,0 -64,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="26"
                android:endX="80"
                android:endY="84"
                android:type="linear">
                <item android:color="#FF6B7280" android:offset="0.0" />
                <item android:color="#FF2B2F36" android:offset="0.5" />
                <item android:color="#FF14171B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dark separator ring -->
    <path
        android:fillColor="#FF0E1013"
        android:pathData="M27,54a27,27 0 1,0 54,0a27,27 0 1,0 -54,0z" />

    <!-- Metallic inner ring -->
    <path android:pathData="M30,54a24,24 0 1,0 48,0a24,24 0 1,0 -48,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="34"
                android:endX="74"
                android:endY="76"
                android:type="linear">
                <item android:color="#FF4B525C" android:offset="0.0" />
                <item android:color="#FF1A1D22" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glass element -->
    <path android:pathData="M34,54a20,20 0 1,0 40,0a20,20 0 1,0 -40,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48"
                android:centerY="48"
                android:gradientRadius="30"
                android:type="radial">
                <item android:color="#FF3F6FE0" android:offset="0.0" />
                <item android:color="#FF1B2F72" android:offset="0.5" />
                <item android:color="#FF070B1C" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner aperture -->
    <path
        android:fillColor="#FF070A19"
        android:pathData="M44,54a10,10 0 1,0 20,0a10,10 0 1,0 -20,0z"
        android:strokeColor="#FF3A4F9E"
        android:strokeWidth="0.8" />

    <!-- Curved glass reflection -->
    <path
        android:pathData="M38.96,48.53A16,16 0 0,1 48.53,38.96"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeLineCap="round"
        android:strokeWidth="2" />

    <!-- Main highlight -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.6"
        android:pathData="M42,45a4,4 0 1,0 8,0a4,4 0 1,0 -8,0z" />

    <!-- Small secondary highlight -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.35"
        android:pathData="M60.2,63a1.8,1.8 0 1,0 3.6,0a1.8,1.8 0 1,0 -3.6,0z" />

    <!-- Red index dot on the barrel -->
    <path
        android:fillColor="#FFE53935"
        android:pathData="M52.6,24.5a1.4,1.4 0 1,0 2.8,0a1.4,1.4 0 1,0 -2.8,0z" />
</vector>